{
  "name": "@nuxus/engine-sdk",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "description": "Framework-independent TypeScript clients for the Nuxus HTTP and WebSocket engine",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "tag": "alpha"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepack": "pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "typescript": "6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxus-org/nuxus-sdk.git",
    "directory": "typescript/engine-sdk"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
